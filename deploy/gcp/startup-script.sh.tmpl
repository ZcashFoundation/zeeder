#!/bin/bash
set -euo pipefail

IMAGE_REF="__IMAGE_REF__"

systemctl stop systemd-resolved || true
printf 'nameserver 8.8.8.8\nnameserver 8.8.4.4\n' > /etc/resolv.conf

# Redirect privileged :53 from the public GCP interface to the container's
# unprivileged :1053. Do not redirect Docker bridge traffic: local agents use
# the upstream resolvers above and would otherwise send their own DNS lookups
# to the authoritative-only Zeeder service.
DNS_INGRESS_INTERFACE=eth0
for _proto in udp tcp; do
  # Remove the legacy all-interface rule when this script updates an existing
  # host without a reboot.
  while iptables -t nat -C PREROUTING -p "${_proto}" --dport 53 \
    -j REDIRECT --to-ports 1053 2>/dev/null; do
    iptables -t nat -D PREROUTING -p "${_proto}" --dport 53 \
      -j REDIRECT --to-ports 1053
  done

  # The `-C` guard keeps boot reruns from stacking duplicate scoped rules.
  iptables -t nat -C PREROUTING -i "${DNS_INGRESS_INTERFACE}" \
    -p "${_proto}" --dport 53 -j REDIRECT --to-ports 1053 2>/dev/null \
    || iptables -t nat -A PREROUTING -i "${DNS_INGRESS_INTERFACE}" \
      -p "${_proto}" --dport 53 -j REDIRECT --to-ports 1053
done

# COS defaults filter INPUT to DROP and opens only SSH. The redirect above
# rewrites the port to 1053 before INPUT sees the packet, and host networking
# means docker adds no accept rule of its own, so without this the DNS traffic
# is dropped and the seeder answers nothing externally. Scope it to the DNS port.
for _proto in udp tcp; do
  iptables -C INPUT -p "${_proto}" --dport 1053 -j ACCEPT 2>/dev/null \
    || iptables -A INPUT -p "${_proto}" --dport 1053 -j ACCEPT
done

# Persist zebra-network's peer cache across container recreation. The image sets
# XDG_CACHE_HOME=/cache (owned by the non-root UID 65532), so mounting a host dir
# there lets a reset/reboot/roll resume the crawler from its last known peers
# instead of starting cold and rediscovering the network from the DNS seeds.
mkdir -p /var/lib/zeeder/cache
chown 65532:65532 /var/lib/zeeder/cache

# Refresh the pinned digest when the registry is reachable, but tolerate a
# transient outage: a reboot must still start the already-pinned local image.
# `docker run` below still fails closed if the digest is absent locally too.
docker pull "${IMAGE_REF}" || true

# Replace only Zeeder. Host logging and monitoring agents are independent
# containers and must survive a seeder reboot or roll.
docker rm -f zeeder 2>/dev/null || true

docker run -d \
  --name zeeder \
  --network host \
  --restart always \
  --log-driver json-file \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  --volume /var/lib/zeeder/cache:/cache \
  --env ZEEDER__DNS__LISTEN_ADDR=0.0.0.0:1053 \
  --env ZEEDER__ZONES__MAINNET__DOMAIN=mainnet.seeder.zfnd.org \
  --env ZEEDER__ZONES__MAINNET__NAMESERVER=__NAMESERVER__ \
  --env ZEEDER__ZONES__MAINNET__TTL=600 \
  --env ZEEDER__ZONES__TESTNET__DOMAIN=testnet.seeder.zfnd.org \
  --env ZEEDER__ZONES__TESTNET__NAMESERVER=__NAMESERVER__ \
  --env ZEEDER__ZONES__TESTNET__TTL=300 \
  --env ZEEDER__METRICS__ENDPOINT_ADDR=127.0.0.1:9999 \
  --env ZEEDER__HEALTH__ENDPOINT_ADDR=127.0.0.1:8080 \
  --env ZEEDER__RATE_LIMIT__QUERIES_PER_SECOND=50 \
  --env ZEEDER__RATE_LIMIT__BURST_SIZE=100 \
  "${IMAGE_REF}"
